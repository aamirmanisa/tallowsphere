{
  "schema_version": "tallow.target_manifest.v2",
  "manifest_id": "example-product-listing-demo",
  "description": "Linux/CachyOS Phase 2 example showing canonical object targets, extraction schema refs, policy, compliance, and artifact rules.",
  "defaults": {
    "headers": {
      "Accept": "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8",
      "User-Agent": "TallowBot/0.4 (+https://nixe.local/tallow)"
    },
    "retry": {
      "max_attempts": 3,
      "retry_on_error_kinds": [
        "transport",
        "dns",
        "timeout",
        "rate_limited",
        "http_5xx"
      ],
      "backoff_ms": [
        250,
        1000
      ]
    },
    "browser_fallback": {
      "mode": "reasoned",
      "reasons": [
        "requires_javascript",
        "http_failed",
        "extraction_failed"
      ],
      "max_fallbacks_per_domain": 2
    },
    "artifact_policy": {
      "capture_body": "redacted",
      "screenshots": "on_fallback_failure",
      "har": "on_fallback_failure",
      "response_snippet_bytes": 4096
    }
  },
  "targets": [
    {
      "id": "example_products_html",
      "url": "https://example.com/products",
      "method": "GET",
      "extraction_schema_ref": "schemas/tallow/examples/product-listing.extraction.schema.json",
      "compliance": {
        "source_authority": "public_web",
        "purpose": "product_catalog_indexing",
        "legal_basis": "legitimate_interest",
        "pii_policy": "no_pii_expected",
        "retention_days": 30,
        "robots_mode": "strict",
        "requires_approval": false
      },
      "tags": [
        "demo",
        "html",
        "phase2"
      ]
    },
    {
      "id": "example_products_graphql",
      "url": "https://example.com/graphql",
      "method": "POST",
      "body": {
        "kind": "json",
        "value": {
          "query": "query Products($limit:Int!){ products(limit:$limit){ name price url } }",
          "variables": {
            "limit": 10
          }
        },
        "content_type": "application/json",
        "redaction": "hash"
      },
      "graphql": {
        "operation_type": "query",
        "operation_name": "Products",
        "variables": {
          "limit": 10
        }
      },
      "extraction_schema_ref": "schemas/tallow/examples/product-listing.extraction.schema.json",
      "compliance": {
        "source_authority": "public_web",
        "purpose": "product_catalog_indexing",
        "legal_basis": "legitimate_interest",
        "pii_policy": "no_pii_expected",
        "retention_days": 30,
        "robots_mode": "strict",
        "requires_approval": false
      },
      "tags": [
        "demo",
        "graphql",
        "phase2"
      ]
    }
  ],
  "policy": {
    "allowlist": {
      "domains": [
        "example.com"
      ],
      "url_patterns": [
        "https://example.com/*"
      ]
    },
    "denylist": {
      "url_patterns": [
        "https://example.com/admin/*",
        "https://example.com/private/*"
      ]
    },
    "robots": {
      "mode": "strict"
    },
    "rate_limits": {
      "per_domain": {
        "example.com": {
          "requests_per_minute": 60,
          "concurrent": 4,
          "cooldown_ms": 250
        }
      },
      "per_ip_pool": {
        "default": {
          "requests_per_minute": 120,
          "concurrent": 8,
          "cooldown_ms": 100
        }
      }
    },
    "cost_budget": {
      "max_browser_fallbacks": 10,
      "max_run_seconds": 300
    },
    "approval_mode": "required_for_sensitive"
  },
  "migration": {
    "from_schema_versions": [
      "legacy-string-targets",
      "configs/tallow/targets.schema.json"
    ],
    "string_targets_default_method": "GET",
    "notes": "Legacy URL strings map to object targets with generated ids, method GET, default retry/artifact/compliance policy, and no body/graphql."
  },
  "schedule": {
    "mode": "manual"
  },
  "tags": [
    "phase2-contract",
    "example"
  ]
}
