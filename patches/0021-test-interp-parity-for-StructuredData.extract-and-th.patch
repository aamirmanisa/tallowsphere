 src/interp.rs                                 |  17 +-
 .../parity_programs/17_structured_data.tl     |  42 ++++
 .../18_structured_data_refusal.tl             |   9 +
 tests/structured_data_parity.rs               | 218 ++++++++++++++++++
 5 files changed, 289 insertions(+), 3 deletions(-)
 create mode 100644 tests/parity/parity_programs/17_structured_data.tl
 create mode 100644 tests/parity/parity_programs/18_structured_data_refusal.tl
 create mode 100644 tests/structured_data_parity.rs

diff --git a/src/codegen.rs b/src/codegen.rs
index cfe4b6c..428d2c2 100644
--- a/src/codegen.rs
+++ b/src/codegen.rs
@@ -18967,8 +18967,12 @@ impl<'a> CodeGen<'a> {
 
         let html = self.emit_expr(&args[0].value)?;
         if !matches!(html.ty, LLType::I8Ptr) {
+            // Wording shared with the interpreter arm (`interp.rs`, the same method) so
+            // the two engines refuse in the same words — the refusal-parity test asserts
+            // on that phrase. This leg refuses at LOWERING time, the interpreter at run
+            // time; the cause is identical either way.
             return Err(format!(
-                "StructuredData.extract: html must be a string, got {}",
+                "StructuredData.extract: expected an HTML string argument, got {}",
