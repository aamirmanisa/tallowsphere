+    /// `StructuredData.extract(html: String) -> StructuredData`
+    ///
+    /// The runtime returns the serialized `open_graph` through the **return slot** and
+    /// writes `json_ld` and `has_json_ld` through out-params — the same split
+    /// `Crawler.from_links` uses, so the refusal path is the existing null check rather
+    /// than new IR failure machinery. This arm copies each value into the struct at its
+    /// layout index.
+    ///
+    /// `has_json_ld` is stored by hand because it is the one struct field anywhere that
+    /// is genuinely `i1`: `emit_store_i64_field` would write eight bytes into one bit
+    /// and silently corrupt the struct.
+    fn emit_structured_data_extract(&mut self, args: &[CallArg]) -> Result<LLValue, String> {
+        if args.len() != 1 {
+            return Err(format!(
+                "StructuredData.extract takes 1 argument (html), got {}",
+                args.len()
+            ));
+        }
+        let Some(layout) = self.struct_layouts.get("StructuredData").cloned() else {
+            return Err("StructuredData.extract: struct layout missing".into());
+        };
+
+        let html = self.emit_expr(&args[0].value)?;
+        if !matches!(html.ty, LLType::I8Ptr) {
+            return Err(format!(
+                "StructuredData.extract: html must be a string, got {}",
+                html.ty.to_ir()
+            ));
+        }
+
+        let json_ld_slot = self.fresh_reg();
+        self.emit_line(&format!("{json_ld_slot} = alloca ptr"));
+        let has_slot = self.fresh_reg();
+        self.emit_line(&format!("{has_slot} = alloca i64, align 8"));
+
+        let graph_out = self.fresh_reg();
+        self.emit_line(&format!(
+            "{graph_out} = call ptr @tallow_structured_data_extract(ptr {}, ptr {json_ld_slot}, ptr {has_slot})",
+            html.reg
+        ));
+        let graph = self.emit_runtime_string_null_check(graph_out, "StructuredData.extract: ")?;
+
+        // sizeof via the emitted type, so the arm never hardcodes a byte count.
+        let size_ptr = self.fresh_reg();
+        self.emit_line(&format!(
+            "{size_ptr} = getelementptr inbounds {0}, ptr null, i32 1",
+            layout.llvm_name
+        ));
+        let size = self.fresh_reg();
+        self.emit_line(&format!("{size} = ptrtoint ptr {size_ptr} to i64"));
+        let struct_ptr = self.fresh_reg();
+        self.emit_line(&format!("{struct_ptr} = call ptr @malloc(i64 {size})"));
+
+        let json_ld = self.fresh_reg();
+        self.emit_line(&format!("{json_ld} = load ptr, ptr {json_ld_slot}"));
+        self.emit_store_ptr_field(&struct_ptr, &layout, "json_ld", &json_ld)?;
+        self.emit_store_ptr_field(&struct_ptr, &layout, "open_graph", &graph.reg)?;
+
+        let (has_idx, _) = layout
+            .field_map
+            .get("has_json_ld")
+            .cloned()
+            .ok_or_else(|| "StructuredData: no field `has_json_ld`".to_string())?;
+        let flag = self.fresh_reg();
+        self.emit_line(&format!("{flag} = load i64, ptr {has_slot}"));
+        let bit = self.fresh_reg();
+        self.emit_line(&format!("{bit} = trunc i64 {flag} to i1"));
+        let bit_slot = self.fresh_reg();
+        self.emit_line(&format!(
+            "{bit_slot} = getelementptr inbounds {}, ptr {struct_ptr}, i32 0, i32 {has_idx}",
+            layout.llvm_name
+        ));
+        self.emit_line(&format!("store i1 {bit}, ptr {bit_slot}"));
+
+        Ok(LLValue::new(struct_ptr, LLType::I8Ptr))
+    }
