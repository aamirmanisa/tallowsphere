+    /// `Crawler.from_sitemap(url) -> Crawler`
+    ///
+    /// NETWORK DISCOVERY: the runtime fetches and parses the sitemap (`SitemapParser` over
+    /// `runtime::egress_http` — Tor by default, refusing rather than falling back to the box
+    /// IP) and returns the discovered `seed_url`; this arm only marshals. The echoed
+    /// `sitemap_url` and the constant `strategy` come back through out-params and the four
+    /// integers through one buffer, the convention `Crawler.from_links` established.
+    fn emit_crawler_from_sitemap(&mut self, args: &[CallArg]) -> Result<LLValue, String> {
+        if args.len() != 1 {
+            return Err(format!(
+                "Crawler.from_sitemap takes 1 argument (url), got {}",
+                args.len()
+            ));
+        }
+        let Some(layout) = self.struct_layouts.get("Crawler").cloned() else {
+            return Err("Crawler.from_sitemap: struct layout missing".into());
+        };
+
+        let url = self.emit_expr(&args[0].value)?;
+        if !matches!(url.ty, LLType::I8Ptr) {
+            // Wording shared with the interpreter arm (`interp.rs`, same method).
+            return Err(format!(
+                "Crawler.from_sitemap: expected a sitemap URL string argument, got {}",
+                url.ty.to_ir()
+            ));
+        }
+
+        let sitemap_slot = self.fresh_reg();
+        self.emit_line(&format!("{sitemap_slot} = alloca ptr"));
+        let strategy_slot = self.fresh_reg();
+        self.emit_line(&format!("{strategy_slot} = alloca ptr"));
+        let buffer = self.fresh_reg();
+        self.emit_line(&format!("{buffer} = alloca [4 x i64], align 8"));
+
+        let seed_out = self.fresh_reg();
+        self.emit_line(&format!(
+            "{seed_out} = call ptr @tallow_crawler_from_sitemap(ptr {}, ptr {sitemap_slot}, ptr {strategy_slot}, ptr {buffer})",
+            url.reg
+        ));
+        let seed_checked =
+            self.emit_runtime_string_null_check(seed_out, "Crawler.from_sitemap: ")?;
+
+        // sizeof via the emitted type, so the arm never hardcodes a byte count.
+        let size_ptr = self.fresh_reg();
+        self.emit_line(&format!(
+            "{size_ptr} = getelementptr inbounds {0}, ptr null, i32 1",
+            layout.llvm_name
+        ));
+        let size = self.fresh_reg();
+        self.emit_line(&format!("{size} = ptrtoint ptr {size_ptr} to i64"));
+        let struct_ptr = self.fresh_reg();
+        self.emit_line(&format!("{struct_ptr} = call ptr @malloc(i64 {size})"));
+
+        self.emit_store_ptr_field(&struct_ptr, &layout, "seed_url", &seed_checked.reg)?;
+        let sitemap = self.fresh_reg();
+        self.emit_line(&format!("{sitemap} = load ptr, ptr {sitemap_slot}"));
+        self.emit_store_ptr_field(&struct_ptr, &layout, "sitemap_url", &sitemap)?;
+        let strategy = self.fresh_reg();
+        self.emit_line(&format!("{strategy} = load ptr, ptr {strategy_slot}"));
+        self.emit_store_ptr_field(&struct_ptr, &layout, "strategy", &strategy)?;
+
+        for (i, field) in ["max_depth", "max_pages", "pages_crawled", "rate_limit_ms"]
+            .iter()
+            .enumerate()
+        {
+            let slot = self.fresh_reg();
+            self.emit_line(&format!(
+                "{slot} = getelementptr inbounds [4 x i64], ptr {buffer}, i32 0, i32 {i}"
+            ));
+            let value = self.fresh_reg();
+            self.emit_line(&format!("{value} = load i64, ptr {slot}"));
+            self.emit_store_i64_field(&struct_ptr, &layout, field, &value)?;
+        }
+        Ok(LLValue::new(struct_ptr, LLType::I8Ptr))
+    }
+
