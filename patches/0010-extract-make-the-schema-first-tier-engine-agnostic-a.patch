+        match resolve_engine_config(&none) {
+            Err(reason) => assert!(reason.contains(LLM_BASE_URL_ENV), "{reason}"),
+            Ok(cfg) => panic!("no base URL must not resolve to a usable engine: {cfg:?}"),
