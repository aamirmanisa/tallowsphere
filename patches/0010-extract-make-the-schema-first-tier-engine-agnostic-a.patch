+
+    #[test]
+    fn a_configured_tier_defaults_to_the_decided_model() {
+        let env = |k: &str| match k {
+            "TALLOW_LLM_BASE_URL" => Some("https://api.example.invalid/v1/".to_string()),
+            _ => None,
